<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">

<struts>
	<constant name="struts.devMode" value="true" />
	<constant name="struts.i18n.reload" value="true" />
	<constant name="struts.enable.DynamicMethodInvocation"
		value="false" />
	<constant name="struts.convention.action.packages"
		value="icsdiscover.coingecko" />
	<constant name="struts.convention.default.parent.package"
		value="json-default" />
	<package name="coingecko_api_client_java"
		extends="struts-default,tiles-default,json-default"
		strict-method-invocation="false">
		<interceptors>
			<interceptor-stack name="appDefaultStack">
				<interceptor-ref name="defaultStack">
					<param name="csp.disabled">true</param>
				</interceptor-ref>
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref
			name="appDefaultStack" />

		<!-- Handles a bare "/" request directly. The Struts filter (mapped to
		     /*) intercepts the root request before the servlet container's
		     welcome-file (index.jsp) mechanism gets a chance to forward it,
		     which otherwise produces "no Action mapped for ... action name
		     []". Mapping the empty action name here fixes that regardless of
		     container/welcome-file behavior. index.jsp is kept as a harmless
		     fallback for direct /index.jsp hits. -->
		<action name="" class="icsdiscover.coingecko.CoinGeckoAction">
			<result name="success" type="tiles">coingecko.screen</result>
		</action>

		<action name="*CoinGecko"
			class="icsdiscover.coingecko.CoinGeckoAction" method="{1}">
			<result name="success" type="tiles">coingecko.screen</result>
		</action>
		<action name="getCoingecko"
			class="icsdiscover.coingecko.CoinGeckoAction">
			<result name="success" type="json" />
		</action>
	</package>
</struts>
